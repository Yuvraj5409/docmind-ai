
# PostgreSQL database
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=docmind

# Full PostgreSQL connection string
DATABASE_URL=postgresql://your_postgres_user:your_postgres_password@localhost:5432/docmind

# Better Auth
BETTER_AUTH_SECRET=replace_with_a_secure_random_secret
BETTER_AUTH_URL=http://localhost:4000

# Frontend URL (comma-separated if multiple origins are needed)
FRONTEND_URL=http://localhost:3000

# Backend API URL (used by the frontend)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=your_gemini_model

# Resend email service
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=DocMind AI <your_verified_sender@example.com>
